    <flow name="get:\inventory:hotel-management-api-config">
		<db:query-single doc:id="33e9cef3-10fa-4189-9c15-8b2a11e27dc6" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT h.hotel_id, h.name AS hotel_name,
       rt.room_type_id, rt.name AS room_type_name, rt.max_occupancy, rt.currency,
       DATEDIFF(:checkOut, :checkIn)         AS nights,
       MIN(ri.total_rooms - ri.booked_rooms) AS available_rooms,
       ROUND(AVG(ri.rate), 2)                AS rate_per_night,
       SUM(ri.rate)                          AS total_stay_amount
FROM room_inventory ri
JOIN room_type rt ON rt.room_type_id = ri.room_type_id
JOIN hotel h      ON h.hotel_id = ri.hotel_id
WHERE ri.hotel_id  = :hotelId
  AND h.status     = 'ACTIVE'
  AND ri.stay_date >= :checkIn
  AND ri.stay_date <  :checkOut
  AND (:roomTypeId IS NULL OR rt.room_type_id  = :roomTypeId)
  AND (:guests     IS NULL OR rt.max_occupancy >= :guests)
GROUP BY h.hotel_id, h.name, rt.room_type_id, rt.name, rt.max_occupancy, rt.currency
HAVING COUNT(*) = DATEDIFF(:checkOut, :checkIn)
ORDER BY rt.room_type_id]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
    hotelId:    attributes.queryParams.hotelId as Number,
    checkIn:    attributes.queryParams.checkInDate,
    checkOut:   attributes.queryParams.checkOutDate,
    roomTypeId: if (attributes.queryParams.roomTypeId != null) attributes.queryParams.roomTypeId as Number else null,
    guests:     if (attributes.queryParams.guests != null) attributes.queryParams.guests as Number else null
}]]]></db:input-parameters>
		</db:query-single>
		<logger level="INFO" doc:name="Logger" doc:id="299f3734-d075-41bc-9128-5b09c3a3534d" message="#[payload]"/>
		<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	rooms: [{
		totalStayAmount: payload.total_stay_amount ,
		availableRooms: payload.available_rooms ,
		roomTypeName: payload.room_type_name,
		ratePerNight: payload.rate_per_night,
		currency: payload.currency,
		maxOccupancy: payload.max_occupancy,
		roomTypeId: payload.room_type_id
	}],
	nights: payload.nights,
	hotelId: payload.hotel_id,
	hotelName: payload.hotel_name
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
